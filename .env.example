# Copy to .env (or .env.local) and edit. Everything here is optional: Complyra runs with none of it.

# Where the SQLite database and auto-generated session secret live (default: ./data)
# COMPLYRA_DATA_DIR=./data

# Session signing secret, 32+ characters. If unset, a random one is generated once and stored in
# the data directory. Set it explicitly if you run more than one instance or want to rotate it.
# SESSION_SECRET=

# Set to 1 only when running behind a reverse proxy you control (nginx, Caddy, a load balancer).
# Then the client IP in the audit log comes from X-Forwarded-For. Leave unset otherwise,
# because a client could forge that header.
# TRUST_PROXY=1

# Optional AI features: plain-language questions on the dashboard, and drafting rules from policy text.
# The AI never computes findings; it only sees totals and finding summaries, never raw statements.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional alerts when an import finds new high-severity issues
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TO_NUMBER=
